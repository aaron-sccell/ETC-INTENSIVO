# URL base de la API de FastAPI.
#
# - Emulador Android (Android Studio): http://10.0.2.2:8000
# - Simulador iOS o navegador web:      http://127.0.0.1:8000
# - Celular fisico con Expo Go:         http://TU_IP_LOCAL:8000  (ej. http://192.168.1.72:8000)
#
# Si dejas esta variable vacia, la app detecta automaticamente la IP de la
# computadora donde corre Metro y usa el puerto 8000.
EXPO_PUBLIC_API_URL=http://192.168.1.72:8000
